---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { amoeba, cdc } from '../data/site';
---

<Layout title={amoeba.heading} description={amoeba.lede}>
  <PageHeader
    eyebrow="Awareness"
    heading={amoeba.heading}
    subheading={amoeba.subheading}
    tint="blue"
  />

  <article class="wrap-narrow prose py-14">
    <p class="text-lg">{amoeba.lede}</p>

    <h2>What it is</h2>
    <ul>
      {amoeba.whatItIs.map((f) => <li>{f}</li>)}
    </ul>

    <h2>Where it lives</h2>
    <p>It thrives in heat and is a natural part of the environment — not a sign of dirty water. It can be found in:</p>
    <ul>
      {amoeba.whereItLives.map((f) => <li>{f}</li>)}
    </ul>

    <h2>How infection happens</h2>
    <p>{amoeba.howInfection}</p>

    <h2>What you cannot get it from</h2>
    <p>This part matters just as much. You <strong>cannot</strong> get this infection from:</p>
    <ul>
      {amoeba.cannotGetFrom.map((f) => <li>{f}</li>)}
    </ul>

    <h2>Who is most at risk</h2>
    <p>{amoeba.whoAtRisk}</p>

    <div class="card mt-10 p-5">
      <p class="text-sm text-muted">
        <strong class="text-ink">Source:</strong> {cdc.note} Information on this page reflects the CDC
        <em>Naegleria fowleri</em> pages reviewed on {cdc.reviewedOn}.
      </p>
      <ul class="mt-3 space-y-1 text-sm">
        {cdc.sources.map((s) => (
          <li><a href={s.url} rel="noopener" target="_blank">{s.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="mt-10 not-prose">
      <a href="/prevention" class="btn btn-primary">Prevention &amp; warning signs</a>
    </div>
  </article>
</Layout>
