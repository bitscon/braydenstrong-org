---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { site, howToHelp } from '../data/site';

const shareUrl = site.url;
const msg = howToHelp.share.shareMessage;
const fbShare = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`;
const xShare = `https://twitter.com/intent/tweet?text=${encodeURIComponent(msg)}`;
const emailShare = `mailto:?subject=${encodeURIComponent('Something worth knowing')}&body=${encodeURIComponent(msg)}`;
const shopLive = !site.merchComingSoon && site.storeUrl && site.storeUrl !== '#';
---

<Layout title={howToHelp.heading} description={howToHelp.subheading}>
  <PageHeader
    eyebrow="Get involved"
    heading={howToHelp.heading}
    subheading={howToHelp.subheading}
    tint="orange"
  />

  <div class="wrap-narrow py-14">
    <!-- Share -->
    <section>
      <h2 class="font-display text-2xl font-extrabold md:text-3xl">{howToHelp.share.heading}</h2>
      <p class="mt-3 text-lg text-ink/85">{howToHelp.share.body}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={fbShare} target="_blank" rel="noopener" class="btn btn-blue">Share on Facebook</a>
        <a href={xShare} target="_blank" rel="noopener" class="btn btn-blue">Share on X</a>
        <a href={emailShare} class="btn btn-outline">Share by email</a>
      </div>
    </section>

    <!-- Shop -->
    <section class="card mt-12 p-8">
      <div class="flex flex-wrap items-center gap-3">
        <h2 class="font-display text-2xl font-extrabold">{howToHelp.shop.heading}</h2>
        {!shopLive && (
          <span class="rounded-full bg-bs-orange-soft px-3 py-1 text-sm font-bold text-bs-orange-deep">
            Coming soon
          </span>
        )}
      </div>
      <p class="mt-3 text-ink/85">
        {shopLive ? howToHelp.shop.bodyLive : howToHelp.shop.bodyComingSoon}
      </p>
      {shopLive && (
        <a href={site.storeUrl} target="_blank" rel="noopener" class="btn btn-primary mt-5">
          {howToHelp.shop.cta.label}
        </a>
      )}
    </section>

    <!-- Future / honesty note -->
    <section class="mt-12 border-l-4 border-bs-blue bg-bs-blue-soft p-6">
      <p class="text-ink/85">{howToHelp.future}</p>
    </section>
  </div>
</Layout>
