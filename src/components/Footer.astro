---
import { site, nav, footer, cdc } from '../data/site';
const hasFacebook = site.facebookUrl && site.facebookUrl !== '#';
const hasInstagram = site.instagramUrl && site.instagramUrl !== '#';
---

<footer class="mt-24 border-t border-line bg-bs-blue-soft">
  <div class="wrap py-12">
    <div class="grid gap-10 md:grid-cols-3">

      <!-- Brand -->
      <div>
        <span class="font-display text-xl font-extrabold text-ink">
          Brayden<span class="text-bs-orange">Strong</span>
        </span>
        <p class="mt-2 max-w-xs text-sm text-muted">{site.tagline}</p>
        {(hasFacebook || hasInstagram) && (
          <div class="mt-4 flex gap-3">
            {hasFacebook && (
              <a href={site.facebookUrl} class="text-bs-blue hover:text-bs-blue-deep" aria-label="Facebook">Facebook</a>
            )}
            {hasInstagram && (
              <a href={site.instagramUrl} class="text-bs-blue hover:text-bs-blue-deep" aria-label="Instagram">Instagram</a>
            )}
          </div>
        )}
      </div>

      <!-- Quick links -->
      <nav aria-label="Footer navigation">
        <h2 class="font-display text-sm font-bold uppercase tracking-wider text-muted">Explore</h2>
        <ul class="mt-3 space-y-2">
          {nav.map(({ label, href }) => (
            <li>
              <a href={href} class="text-sm font-semibold text-ink/80 hover:text-bs-blue">{label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Honesty note + source -->
      <div>
        <h2 class="font-display text-sm font-bold uppercase tracking-wider text-muted">About this site</h2>
        <p class="mt-3 text-sm text-muted">{footer.statusNote}</p>
        <p class="mt-3 text-xs text-muted">{cdc.note}</p>
      </div>
    </div>

    <div class="mt-10 border-t border-line pt-6 text-sm text-muted">
      {footer.copyright}
    </div>
  </div>
</footer>
